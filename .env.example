NODE_ENV=development
PORT=3000
LOG_LEVEL=info
ORGANIZATION_NAME=DeExclusives Music Organization
BOT_NAME=Mama Hope
ORGANIZATION_TIMEZONE=Africa/Lagos

# Use memory for the functional local/test mode. Set postgres in staging/production.
STORE_DRIVER=memory
DATABASE_URL=postgresql://mama_hope:change-me@localhost:5432/mama_hope

SUPER_ADMIN_WHATSAPP_JID=234XXXXXXXXXX@s.whatsapp.net
BOT_WHATSAPP_JID=234XXXXXXXXXX@s.whatsapp.net
INTERNAL_API_TOKEN=change-this-to-a-long-random-secret

# "memory" is safe for local development. The Baileys adapter is intentionally
# disabled until a dedicated bot account and protected session storage are ready.
WHATSAPP_GATEWAY=memory
# Fail-closed: set true only after reviewing all configured recipients and jobs.
WHATSAPP_SEND_ENABLED=false
# Proactive private summary remains opt-in and is disabled by default.
AUTO_SEND_DAILY_SUMMARY=false
WHATSAPP_SESSION_DIR=./data/whatsapp-session
WHATSAPP_CONNECT_TIMEOUT_MS=30000
# Optional one-time pairing-code number: country code + number, digits only.
WHATSAPP_PAIRING_PHONE=
# Optional emergency DNS override for web.whatsapp.com. Usually leave blank.
WHATSAPP_HOST_IP=

# Optional local/bootstrap roster. Keep real member data in .env, not source control.
OFFICIALS_GROUP_JID=
OFFICIALS_GROUP_NAME=
COMMUNITY_GROUP_JID=
COMMUNITY_GROUP_NAME=
BOOTSTRAP_OFFICIALS_JSON=

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=mama-hope-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=./data/media

AI_PROVIDER=groq
AI_MODEL=
# Comma-separated fallback list. Used when AI_MODEL is blank.
AI_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b
AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=15000
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_ACCESS_TOKEN=
OPPORTUNITY_RSS_URLS=
SENTRY_DSN=
